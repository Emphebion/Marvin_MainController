{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python: MARVIN Main Launcher",
            "type": "debugpy",
            "request": "launch",
            // Launch the MARVIN entry script unambiguously using workspace paths
            // Update the path if your MARVIN entry file is located elsewhere in the workspace
            "program": "${workspaceFolder}/MARVIN.py",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            // Use the currently selected Python interpreter in VS Code
            "python": "${command:python.interpreterPath}"
        }
    ]
}